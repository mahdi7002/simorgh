*.fst
*.ie
*.dubm
vosk-model*/
*.zip
*.zip.*

# ===== Editor / OS junk =====
*.save
*.save.*
*.swp
*~
.DS_Store
Thumbs.db

# ===== Secrets — never commit =====
.env
*.env
keys.env
*_key*.json
device_report.json

# ===== Build artifacts =====
build/
dist/
*.o
